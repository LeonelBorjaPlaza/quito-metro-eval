# =============================================================================
# DATA FILES — regenerable or external, do not commit
# =============================================================================
# Large data binaries (ignored regardless of folder)
*.dta
*.parquet
*.gpkg
*.tif
*.tiff
*.nc
*.h5
*.zip
*.7z
*.gz
*.tar

# Raw data folder: ignore data files, allow documentation
data/raw/**/*.csv
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.pdf

# Processed/working: ignore most CSV outputs (regenerable from raw)
# Note: existing committed CSVs in data/processed/ stay tracked.
data/processed/**/*.csv
data/working/temp_chunks/

# Allow the small UCDB shapefile (documents the GEE asset)
!data/working/ucdb_lac.*

# =============================================================================
# R
# =============================================================================
.Rhistory
.RData
.RDataTmp
.Ruserdata
.Rapp.history
.Rproj.user/

# renv (keep lock + activate only)
renv/library/
renv/local/
renv/cellar/
renv/python/
renv/staging/

# =============================================================================
# Python
# =============================================================================
myenv/
.venv/
__pycache__/
*.pyc

# =============================================================================
# OS / OneDrive cruft
# =============================================================================
.DS_Store
Thumbs.db
*.tmp
~$*
.~lock.*
data/raw/
