# Stata and parquet binary panels generally not tracked
*.dta
*.parquet

# But DO track the small UCDB shapefile so the GEE asset is documented
!data/working/ucdb_lac.*

# Python environments and caches
myenv/
.venv/
__pycache__/
*.pyc
